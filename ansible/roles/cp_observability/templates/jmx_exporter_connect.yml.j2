# =============================================================================
# JMX Exporter Configuration -- Kafka Connect
# =============================================================================
# Generated by cp_observability role
# Port: {{ cp_obs_connect_jmx_port }} (cp-ansible default for Connect JMX exporter)
# =============================================================================

hostPort: "{{ ansible_host | default(inventory_hostname) }}:{{ cp_obs_connect_jmx_port }}"
lowercaseOutputName: true
lowercaseOutputLabelNames: true

rules:
  # -- Worker metrics --
  - pattern: "kafka.connect<type=connect-worker-metrics><>connector-count"
    name: kafka_connect_worker_connector_count
    type: GAUGE
    help: "Number of connectors deployed to this worker"

  - pattern: "kafka.connect<type=connect-worker-metrics><>task-count"
    name: kafka_connect_worker_task_count
    type: GAUGE
    help: "Number of tasks running on this worker"

  - pattern: "kafka.connect<type=connect-worker-metrics><>connector-startup-failure-total"
    name: kafka_connect_worker_connector_startup_failure_total
    type: COUNTER
    help: "Total number of connector startup failures"

  - pattern: "kafka.connect<type=connect-worker-metrics><>task-startup-failure-total"
    name: kafka_connect_worker_task_startup_failure_total
    type: COUNTER
    help: "Total number of task startup failures"

  # -- Connector metrics --
  - pattern: "kafka.connect<type=connector-metrics, connector=(.*)><>status"
    name: kafka_connect_connector_status
    type: UNTYPED
    help: "Connector status (RUNNING, PAUSED, FAILED, UNASSIGNED)"
    labels:
      connector: "$1"

  - pattern: "kafka.connect<type=connector-metrics, connector=(.*)><>connector-type"
    name: kafka_connect_connector_type
    type: UNTYPED
    help: "Connector type (source or sink)"
    labels:
      connector: "$1"

  # -- Task metrics --
  - pattern: "kafka.connect<type=connector-task-metrics, connector=(.*), task=(.*)><>batch-size-avg"
    name: kafka_connect_task_batch_size_avg
    type: GAUGE
    help: "Average batch size for connector task"
    labels:
      connector: "$1"
      task: "$2"

  - pattern: "kafka.connect<type=connector-task-metrics, connector=(.*), task=(.*)><>offset-commit-success-percentage"
    name: kafka_connect_task_offset_commit_success_pct
    type: GAUGE
    help: "Percentage of successful offset commits"
    labels:
      connector: "$1"
      task: "$2"

  - pattern: "kafka.connect<type=connector-task-metrics, connector=(.*), task=(.*)><>running-ratio"
    name: kafka_connect_task_running_ratio
    type: GAUGE
    help: "Fraction of time the task is in running state"
    labels:
      connector: "$1"
      task: "$2"
