{# =============================================================================
   Prometheus file_sd_configs target file
   =============================================================================
   Generated by cp_observability role from Ansible inventory host groups.
   Prometheus watches this file and automatically picks up changes without
   restart. Each CP component gets its own target group with appropriate JMX
   exporter port and labels for identification.
   ============================================================================= #}
[
{% if groups.get('kafka_broker', []) | length > 0 %}
  {
    "targets": [
{% for host in groups['kafka_broker'] %}
      "{{ hostvars[host]['ansible_host'] | default(host) }}:{{ cp_obs_broker_jmx_port }}"{% if not loop.last %},{% endif %}

{% endfor %}
    ],
    "labels": {
      "job": "kafka-broker",
      "cluster": "{{ cp_obs_cluster_name }}",
      "environment": "{{ cp_obs_environment }}"
    }
  }{% if groups.get('schema_registry', []) | length > 0 or groups.get('kafka_connect', []) | length > 0 or groups.get('zookeeper', []) | length > 0 %},{% endif %}

{% endif %}
{% if groups.get('schema_registry', []) | length > 0 %}
  {
    "targets": [
{% for host in groups['schema_registry'] %}
      "{{ hostvars[host]['ansible_host'] | default(host) }}:{{ cp_obs_sr_jmx_port }}"{% if not loop.last %},{% endif %}

{% endfor %}
    ],
    "labels": {
      "job": "schema-registry",
      "cluster": "{{ cp_obs_cluster_name }}",
      "environment": "{{ cp_obs_environment }}"
    }
  }{% if groups.get('kafka_connect', []) | length > 0 or groups.get('zookeeper', []) | length > 0 %},{% endif %}

{% endif %}
{% if groups.get('kafka_connect', []) | length > 0 %}
  {
    "targets": [
{% for host in groups['kafka_connect'] %}
      "{{ hostvars[host]['ansible_host'] | default(host) }}:{{ cp_obs_connect_jmx_port }}"{% if not loop.last %},{% endif %}

{% endfor %}
    ],
    "labels": {
      "job": "kafka-connect",
      "cluster": "{{ cp_obs_cluster_name }}",
      "environment": "{{ cp_obs_environment }}"
    }
  }{% if groups.get('zookeeper', []) | length > 0 %},{% endif %}

{% endif %}
{% if groups.get('zookeeper', []) | length > 0 %}
  {
    "targets": [
{% for host in groups['zookeeper'] %}
      "{{ hostvars[host]['ansible_host'] | default(host) }}:{{ cp_obs_zk_jmx_port }}"{% if not loop.last %},{% endif %}

{% endfor %}
    ],
    "labels": {
      "job": "zookeeper",
      "cluster": "{{ cp_obs_cluster_name }}",
      "environment": "{{ cp_obs_environment }}"
    }
  }
{% endif %}
]
