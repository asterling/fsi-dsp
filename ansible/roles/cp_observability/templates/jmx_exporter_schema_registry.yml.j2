# =============================================================================
# JMX Exporter Configuration -- Schema Registry
# =============================================================================
# Generated by cp_observability role
# Port: {{ cp_obs_sr_jmx_port }} (cp-ansible default for SR JMX exporter)
# =============================================================================

hostPort: "{{ ansible_host | default(inventory_hostname) }}:{{ cp_obs_sr_jmx_port }}"
lowercaseOutputName: true
lowercaseOutputLabelNames: true

rules:
  # -- API call metrics --
  - pattern: "kafka.schema.registry<type=jersey-metrics, http_status_code=(.*)><>request-rate"
    name: kafka_schema_registry_request_rate
    type: GAUGE
    help: "Schema Registry API request rate by HTTP status code"
    labels:
      http_status_code: "$1"

  - pattern: "kafka.schema.registry<type=jersey-metrics, http_status_code=(.*)><>request-latency-avg"
    name: kafka_schema_registry_request_latency_avg
    type: GAUGE
    help: "Average request latency by HTTP status code (ms)"
    labels:
      http_status_code: "$1"

  - pattern: "kafka.schema.registry<type=jersey-metrics, http_status_code=(.*)><>request-latency-99"
    name: kafka_schema_registry_request_latency_p99
    type: GAUGE
    help: "P99 request latency by HTTP status code (ms)"
    labels:
      http_status_code: "$1"

  # -- Schema count metrics --
  - pattern: "kafka.schema.registry<type=SchemaRegistryMetric, name=registered-count><>Value"
    name: kafka_schema_registry_registered_count
    type: GAUGE
    help: "Total number of registered schemas"

  - pattern: "kafka.schema.registry<type=SchemaRegistryMetric, name=schemas-deleted><>Value"
    name: kafka_schema_registry_schemas_deleted
    type: COUNTER
    help: "Total number of deleted schemas"

  # -- Leader election metrics --
  - pattern: "kafka.schema.registry<type=SchemaRegistryMetric, name=master-slave-role><>Value"
    name: kafka_schema_registry_leader_role
    type: GAUGE
    help: "Schema Registry leader role (1=leader, 0=follower)"
