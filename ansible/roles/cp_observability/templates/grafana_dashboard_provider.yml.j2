# =============================================================================
# Grafana Dashboard Provisioning Config
# =============================================================================
# Generated by cp_observability role. Tells Grafana to auto-load dashboards
# from the provisioning directory on startup and file change.
# =============================================================================
apiVersion: 1

providers:
  - name: fsi-kafka-dashboards
    orgId: 1
    folder: FSI Kafka
    type: file
    disableDeletion: false
    updateIntervalSeconds: 30
    allowUiUpdates: true
    options:
      path: "{{ cp_obs_grafana_provisioning_dir }}"
      foldersFromFilesStructure: false
