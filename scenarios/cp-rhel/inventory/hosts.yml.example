# =============================================================================
# Ansible Inventory -- Confluent Platform on RHEL
# =============================================================================
# Copy this file to hosts.yml and customize with your actual hostnames and IPs.
#
# Usage:
#   cp hosts.yml.example hosts.yml
#   # Edit hosts.yml with your values
#   ansible-playbook -i inventory/hosts.yml playbooks/deploy-cp.yml
# =============================================================================

all:
  vars:
    # Common settings applied to all hosts
    ansible_connection: ssh
    ansible_user: confluent
    ansible_become: true

    # CP version -- must match the cp-ansible collection version
    confluent_server_enabled: true
    confluent_package_version: "7.6.0"

  children:
    # -------------------------------------------------------------------------
    # Kafka Brokers (3 nodes, multi-rack)
    # -------------------------------------------------------------------------
    kafka_broker:
      hosts:
        kafka-east-1:
          ansible_host: 10.0.1.11
          kafka_broker_custom_properties:
            broker.id: 1
            broker.rack: us-east-1a
        kafka-east-2:
          ansible_host: 10.0.1.12
          kafka_broker_custom_properties:
            broker.id: 2
            broker.rack: us-east-1b
        kafka-east-3:
          ansible_host: 10.0.1.13
          kafka_broker_custom_properties:
            broker.id: 3
            broker.rack: us-east-1c

    # -------------------------------------------------------------------------
    # Schema Registry (2 nodes, HA)
    # -------------------------------------------------------------------------
    schema_registry:
      hosts:
        sr-east-1:
          ansible_host: 10.0.2.11
        sr-east-2:
          ansible_host: 10.0.2.12

    # -------------------------------------------------------------------------
    # Kafka Connect (2 nodes, distributed mode)
    # -------------------------------------------------------------------------
    kafka_connect:
      hosts:
        connect-east-1:
          ansible_host: 10.0.3.11
        connect-east-2:
          ansible_host: 10.0.3.12

    # -------------------------------------------------------------------------
    # Standalone Flink (open-source Apache Flink, not CP Flink which requires K8s)
    # -------------------------------------------------------------------------
    flink_jobmanager:
      hosts:
        flink-jm-1: {}
    flink_taskmanager:
      hosts:
        flink-tm-1: {}
        flink-tm-2: {}
