# =============================================================================
# FSI Kafka Platform — Environment Configuration
# =============================================================================
# Copy to .env and fill in. This is the SINGLE source of truth for all
# environment-specific values. Scripts source this; Terraform reads tfvars.
# =============================================================================

# ── 1. NAMING ──
ORG_PREFIX=""                                    # Optional org prefix for topic names
TOPIC_NAMING_STRATEGY="domain-first"             # domain-first | org-prefix | env-prefix
ENVIRONMENT="prod"                               # prod | staging | dev | dr

# ── 2. CONFLUENT CLOUD — ORGANIZATION ──
CC_ORG_ID="org-xxxxx"
CC_ENV_ID="env-xxxxx"

# ── 3. PRODUCTION CLUSTER ──
CC_KAFKA_CLUSTER_ID="lkc-xxxxx"
CC_KAFKA_BOOTSTRAP="pkc-xxxxx.eastus2.azure.confluent.cloud:9092"
CC_KAFKA_REST_ENDPOINT="https://pkc-xxxxx.eastus2.azure.confluent.cloud:443"
CC_KAFKA_API_KEY=""                              # SENSITIVE
CC_KAFKA_API_SECRET=""                           # SENSITIVE
CC_KAFKA_CLUSTER_TYPE="dedicated"                # dedicated | enterprise

# ── 4. DR CLUSTER ──
CC_DR_KAFKA_CLUSTER_ID="lkc-yyyyy"
CC_DR_KAFKA_BOOTSTRAP="pkc-yyyyy.westus2.azure.confluent.cloud:9092"
CC_DR_KAFKA_REST_ENDPOINT="https://pkc-yyyyy.westus2.azure.confluent.cloud:443"
CC_DR_KAFKA_API_KEY=""                           # SENSITIVE
CC_DR_KAFKA_API_SECRET=""                        # SENSITIVE

# ── 5. SCHEMA REGISTRY ──
CC_SR_CLUSTER_ID="lsrc-xxxxx"
CC_SR_REST_ENDPOINT="https://psrc-xxxxx.eastus2.azure.confluent.cloud"
CC_SR_API_KEY=""                                 # SENSITIVE
CC_SR_API_SECRET=""                              # SENSITIVE
CC_GOVERNANCE_PACKAGE="advanced"                 # advanced | essentials

# ── 6. CLUSTER LINKING ──
CC_CLUSTER_LINK_NAME="cluster-link-bidir-prod-dr"

# ── 7. CLOUD PROVIDER ──
CLOUD_PROVIDER="azure"                           # azure | aws | gcp
CC_PROD_REGION="eastus2"                         # Azure regions
CC_DR_REGION="westus2"

# 7a. Azure-specific (when CLOUD_PROVIDER=azure)
AZURE_SUBSCRIPTION_ID=""
AZURE_RESOURCE_GROUP=""
AZURE_VNET_ID=""
AZURE_SUBNET_ID=""
AZURE_TENANT_ID=""                               # For OAuth/Entra ID
AZURE_CLIENT_ID=""                               # App registration
AZURE_CLIENT_SECRET=""                           # SENSITIVE

# 7b. AWS-specific (when CLOUD_PROVIDER=aws)
AWS_ACCOUNT_ID=""
AWS_REGION="us-east-1"
AWS_VPC_ID=""
AWS_SUBNET_IDS=""
# TF backend
TF_BACKEND_S3_BUCKET=""
TF_BACKEND_S3_REGION="us-east-1"
TF_BACKEND_DYNAMODB_TABLE="fsi-terraform-locks"

# 7c. GCP-specific (when CLOUD_PROVIDER=gcp)
GCP_PROJECT_ID=""
GCP_REGION="us-east1"
GCP_NETWORK=""
GCP_SUBNETWORK=""
# TF backend
TF_BACKEND_GCS_BUCKET=""
TF_BACKEND_GCS_PREFIX="kafka-platform/prod"

# ── 8. SERVICE DISCOVERY ──
SD_PROVIDER="consul"                             # consul | dns | none
SD_KAFKA_ENDPOINT="kafka.internal"
SD_SCHEMA_ENDPOINT="schema.internal"
SD_DATABASE_ENDPOINT="database.internal"
CONSUL_HTTP_ADDR="http://consul.internal:8500"

# ── 9. SECRETS ──
SECRETS_PROVIDER="vault"                         # vault | azure-keyvault | aws-secrets-manager
VAULT_ADDR="https://vault.internal:8200"

# ── 10. DATABASE ──
DB_TYPE="oracle"                                 # oracle | sqlserver | postgresql
DB_HOST_PRIMARY="database-primary.internal"
DB_PORT="1521"                                   # Oracle: 1521 | SQL Server: 1433 | PG: 5432
DB_NAME="COREDB"
DB_DR_TECHNOLOGY="dataguard"                     # dataguard | always-on | streaming-replication

# ── 11. OBSERVABILITY ──
OBSERVABILITY_PROVIDER="dynatrace"               # dynatrace | datadog | splunk | prometheus | newrelic | instana

# 11a. Dynatrace (when OBSERVABILITY_PROVIDER=dynatrace)
DYNATRACE_ENVIRONMENT_URL=""                     # e.g., https://abc12345.live.dynatrace.com
DYNATRACE_API_TOKEN=""                           # SENSITIVE — API v2 token with metrics.read scope

# 11b. Datadog (when OBSERVABILITY_PROVIDER=datadog)
DATADOG_API_KEY=""                               # SENSITIVE
DATADOG_APP_KEY=""                               # SENSITIVE
DATADOG_SITE="datadoghq.com"                     # datadoghq.com | datadoghq.eu | us3.datadoghq.com

# 11c. Splunk (when OBSERVABILITY_PROVIDER=splunk)
SPLUNK_HEC_URL=""                                # e.g., https://splunk.internal:8088
SPLUNK_HEC_TOKEN=""                              # SENSITIVE
SPLUNK_INDEX="kafka"

# 11d. Prometheus/Grafana (when OBSERVABILITY_PROVIDER=prometheus)
PROMETHEUS_ENDPOINT="http://prometheus.internal:9090"
GRAFANA_URL="http://grafana.internal:3000"
GRAFANA_API_KEY=""                               # SENSITIVE — for dashboard import API

# 11e. New Relic (when OBSERVABILITY_PROVIDER=newrelic)
NEWRELIC_ACCOUNT_ID=""
NEWRELIC_API_KEY=""                              # SENSITIVE — NerdGraph User API key
NEWRELIC_REGION="US"                             # US | EU

# 11f. IBM Instana (when OBSERVABILITY_PROVIDER=instana)
INSTANA_HOST=""                                  # e.g., instana.internal
INSTANA_API_TOKEN=""                             # SENSITIVE
INSTANA_TENANT=""
INSTANA_UNIT=""

# 11g. Common alert thresholds (defaults from ADR-008)
ALERT_CL_LAG_SECONDS=30                          # Mirror lag alert threshold (seconds, critical tier default)
ALERT_CONSUMER_LAG_RECORDS=10000                 # Consumer lag alert threshold (records, standard tier default)

# 11h. Confluent Cloud Metrics API (all providers for CC deployments)
CC_METRICS_API_KEY=""                            # SENSITIVE — CC Metrics API key
CC_METRICS_API_SECRET=""                         # SENSITIVE — CC Metrics API secret

# ── 12. CONNECT ──
CONNECT_REST_URL="http://connect.internal:8083"
CONNECT_GROUP_ID="fsi-connect-cluster"

# ── 13. TERRAFORM BACKEND ──
TERRAFORM_BACKEND="azurerm"                      # azurerm | s3 | gcs
# Azure backend (TERRAFORM_BACKEND=azurerm)
TF_BACKEND_RESOURCE_GROUP=""
TF_BACKEND_STORAGE_ACCOUNT=""
TF_BACKEND_CONTAINER="tfstate"
TF_BACKEND_KEY="kafka-platform/prod/terraform.tfstate"
# AWS backend (TERRAFORM_BACKEND=s3) — see also 7b above
# TF_BACKEND_S3_BUCKET, TF_BACKEND_S3_REGION, TF_BACKEND_DYNAMODB_TABLE
# GCP backend (TERRAFORM_BACKEND=gcs) — see also 7c above
# TF_BACKEND_GCS_BUCKET, TF_BACKEND_GCS_PREFIX

# ── 14. FLINK ──
CC_FLINK_ENABLED="false"                          # true | false — enable Flink compute pool
CC_FLINK_COMPUTE_POOL_NAME="fsi-prod-pool"        # Display name for the compute pool
CC_FLINK_MAX_CFU=5                                # Max CFUs: 5, 10, 20, 30, 40, 50 (cannot decrease)
CC_FLINK_REGION=""                                # Region for compute pool (match Kafka cluster region)
CC_FLINK_REST_ENDPOINT=""                         # Flink REST endpoint
CC_FLINK_API_KEY=""                               # SENSITIVE — Flink API key
CC_FLINK_API_SECRET=""                            # SENSITIVE — Flink API secret
CC_FLINK_SERVICE_ACCOUNT_ID=""                    # SA ID for Flink statement principal

# ── 15. CFK on OpenShift ──
# CFK scenario-specific configuration for Confluent for Kubernetes on OpenShift.
# Only needed when deploying the scenarios/cfk-openshift/ scenario.

# CFK Operator
# CFK_NAMESPACE=confluent
# CFK_OPERATOR_VERSION=3.2

# Flink Kubernetes Operator
# FLINK_OPERATOR_NAMESPACE=flink
# FLINK_OPERATOR_VERSION=1.14.0
# FLINK_IMAGE=fsi-flink:1.20

# MM2 DR Backend
# FSI_DR_BACKEND=mm2
# FSI_MM2_CONNECT_URL=http://connect-mm2.confluent.svc.cluster.local:8083
# FSI_MM2_SOURCE_CONNECTOR=mm2-source-east-west
# FSI_MM2_CHECKPOINT_CONNECTOR=mm2-checkpoint-east-west
# FSI_MM2_HEARTBEAT_CONNECTOR=mm2-heartbeat-east-west
# FSI_MM2_SOURCE_ALIAS=east
# FSI_MM2_TARGET_ALIAS=west
