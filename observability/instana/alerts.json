{
  "name": "FSI Kafka Platform - Alert Configurations",
  "description": "Instana alert configurations for FSI Kafka Platform. Import via Instana API POST /api/events/settings/alert-configs.",
  "alerts": [
    {
      "name": "MirrorLagCritical - Warning",
      "description": "Mirror lag exceeds warn threshold for critical tier (30s). Monitor for further degradation.",
      "severity": 5,
      "triggering": true,
      "rule": {
        "ruleType": "threshold",
        "metricName": "cluster_link_mirror_topic_offset_lag",
        "conditionOperator": "ABOVE",
        "conditionValue": 30000,
        "window": 60,
        "aggregation": "MAX"
      },
      "tagFilterExpression": {
        "type": "EXPRESSION",
        "logicalOperator": "AND",
        "elements": [
          { "name": "sla_tier", "operator": "EQUALS", "value": "critical" }
        ]
      },
      "labels": { "team": "fsi-kafka", "sla_tier": "critical" }
    },
