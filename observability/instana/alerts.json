    {
      "name": "ConnectTaskFailed",
      "description": "One or more Kafka Connect connector tasks are in FAILED state. Check Connect logs and restart if appropriate.",
      "severity": 10,
      "triggering": true,
      "rule": {
        "ruleType": "threshold",
        "metricName": "connect.connector.failed_count",
        "conditionOperator": "ABOVE_OR_EQUALS",
        "conditionValue": 1,
        "window": 60,
        "aggregation": "MAX"
      },
      "tagFilterExpression": {},
      "labels": { "team": "fsi-kafka" }
    },
    {
      "name": "ConnectTaskRestartLoop",
      "description": "A Kafka Connect task has restarted 3 or more times in the last 15 minutes. Investigate root cause to prevent repeated failures.",
      "severity": 5,
      "triggering": true,
      "rule": {
        "ruleType": "threshold",
        "metricName": "connect.task.restart_count",
        "conditionOperator": "ABOVE_OR_EQUALS",
        "conditionValue": 3,
        "window": 900,
        "aggregation": "MAX"
      },
      "tagFilterExpression": {},
      "labels": { "team": "fsi-kafka" }
    },
    {
      "name": "UnderReplicatedPartitions",
      "description": "Under-replicated partitions detected. This indicates broker health issues or network problems. Investigate immediately.",
      "severity": 10,
      "triggering": true,
      "rule": {
        "ruleType": "threshold",
        "metricName": "under_replicated_partitions",
        "conditionOperator": "ABOVE",
        "conditionValue": 0,
        "window": 300,
        "aggregation": "SUM"
      },
      "tagFilterExpression": {
        "type": "EXPRESSION",
        "logicalOperator": "AND",
        "elements": [
          { "name": "kafka_id", "operator": "EQUALS", "value": "{{CLUSTER_ID}}" }
        ]
      },
      "labels": { "team": "fsi-kafka" }
    }
