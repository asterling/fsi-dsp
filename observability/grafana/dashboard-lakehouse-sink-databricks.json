{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource for Confluent Cloud metrics or JMX exporter metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_JSON",
      "label": "JSON API",
      "description": "JSON API datasource for Connect REST API polling. Configure with base URL of the lakehouse Connect cluster.",
      "type": "datasource",
      "pluginId": "marcusolsson-json-datasource",
      "pluginName": "JSON API"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "FSI Kafka Platform",
        "type": "dashboard"
      }
    ]
  },
  "description": "FSI Kafka Platform - Databricks Delta Lake Sink observability. Tracks the DB-C path from ADR-011: connector state, task health, throughput, DLQ rate, and Databricks SQL warehouse queue depth.",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "ADR-011 Lakehouse Integration Patterns",
      "url": "/docs/adr/011-lakehouse-integration-patterns.md"
    },
    {
      "title": "Databricks Integration Guide",
      "url": "/docs/databricks-integration-guide.md"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Active Databricks Sinks",
      "description": "Number of lakehouse-databricks-* connectors currently registered.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": "${DS_JSON}",
      "targets": [
        {
          "method": "GET",
          "urlPath": "/connectors?expand=info",
          "fields": [
            { "jsonPath": "$..[?(@.info.config['connector.class']=='io.confluent.connect.databricks.DatabricksDeltaLakeSinkConnector')]", "type": "number", "name": "count" }
          ],
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#6B7280", "value": null },
              { "color": "#22C55E", "value": 1 }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "FAILED Tasks",
      "description": "Databricks sink tasks in FAILED state. Any non-zero value is paging-worthy for critical/compliance SLA tiers.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(kafka_connect_connector_task_status{connector=~\"lakehouse-databricks-.*\", state=\"failed\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#22C55E", "value": null },
              { "color": "#EF4444", "value": 1 }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "title": "DLQ Rate (records/sec)",
      "description": "Rate of records routed to lakehouse.dlq.databricks-* topics. Spikes indicate schema or table compatibility issues.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(confluent_kafka_server_received_records{topic=~\"lakehouse\\\\.dlq\\\\.databricks-.*\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#22C55E", "value": null },
              { "color": "#EAB308", "value": 1 },
              { "color": "#EF4444", "value": 10 }
            ]
          },
          "unit": "rps"
        }
      }
    },
    {
      "id": 4,
      "title": "Throughput (records/sec)",
      "description": "Successful records-per-second flowing into Databricks Delta tables.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(kafka_connect_sink_record_send_total{connector=~\"lakehouse-databricks-.*\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "#22C55E", "value": null } ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Connector + Task State",
      "description": "Per-connector state with task-level breakdown. Auto-discovers all lakehouse-databricks-* connectors.",
      "type": "table",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 6 },
      "datasource": "${DS_JSON}",
      "targets": [
        {
          "method": "GET",
          "urlPath": "/connectors?expand=status&forConnector=lakehouse-databricks-",
          "fields": [
            { "jsonPath": "$.*", "type": "string" }
          ],
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Records sent per task (5m rate)",
      "description": "Per-task throughput. Uneven distribution suggests partition assignment imbalance.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "rate(kafka_connect_sink_record_send_total{connector=~\"lakehouse-databricks-.*\"}[5m])",
          "legendFormat": "{{connector}} task {{task}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "rps" }
      }
    },
    {
      "id": 7,
      "title": "Commit latency to Delta (p95)",
      "description": "Time from Connect receipt to Delta commit acknowledgement. Tableflow (DB-A) bypasses this latency entirely; see dashboard-tableflow.json.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (connector, le) (rate(kafka_connect_sink_put_batch_duration_ms_bucket{connector=~\"lakehouse-databricks-.*\"}[5m])))",
          "legendFormat": "{{connector}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["fsi-kafka", "lakehouse", "databricks", "observability"],
  "templating": {
    "list": [
      {
        "name": "CONNECT_REST_URL",
        "label": "Connect REST URL",
        "type": "textbox",
        "current": { "value": "https://connect-lakehouse.confluent.svc.cluster.local:8083" },
        "options": [],
        "description": "Lakehouse Connect cluster REST endpoint"
      },
      {
        "name": "ENVIRONMENT",
        "label": "Environment",
        "type": "textbox",
        "current": { "value": "prod" },
        "options": []
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "FSI Kafka - Lakehouse Sink - Databricks (DB-C)",
  "uid": "fsi-kafka-lakehouse-databricks",
  "version": 1,
  "weekStart": ""
}
