{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource for CC Flink metrics via CC Metrics API Prometheus export",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "FSI Kafka Platform",
        "type": "dashboard"
      }
    ]
  },
  "description": "FSI Kafka Platform - Flink Jobs monitoring. Tracks running Flink SQL statements, records throughput (in/out), pending records (backpressure proxy), per-statement output, and CFU utilization via CC Metrics API (io.confluent.flink/* namespace).",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Running Flink Statements",
      "description": "Count of active Flink SQL statements producing output. Uses io.confluent.flink/num_records_out to detect active statements.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "count(io_confluent_flink_num_records_out{resource_type=\"flink_statement\"} > 0)",
          "legendFormat": "Running Statements",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#6B7280", "value": null },
              { "color": "#22C55E", "value": 1 }
            ]
          },
          "unit": "short",
          "noValue": "No Flink statements running"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Records Throughput",
      "description": "Flink SQL statement records throughput (in and out) via CC Metrics API. Rate of io.confluent.flink/num_records_out and io.confluent.flink/num_records_in over 5m window.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "rate(io_confluent_flink_num_records_out{resource_type=\"flink_statement\"}[5m])",
          "legendFormat": "{{statement_name}} out",
          "refId": "A"
        },
        {
          "expr": "rate(io_confluent_flink_num_records_in{resource_type=\"flink_statement\"}[5m])",
          "legendFormat": "{{statement_name}} in",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "id": 3,
      "title": "Pending Records",
      "description": "Maximum pending records across Flink SQL statements. Serves as a backpressure proxy -- high pending records indicate slow processing or backpressure. CC Metrics API metric: io.confluent.flink/pending_records.",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "max(io_confluent_flink_pending_records{resource_type=\"flink_statement\"})",
          "legendFormat": "Max Pending Records",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#22C55E", "value": null },
              { "color": "#22C55E", "value": 0 },
              { "color": "#EAB308", "value": 1000 },
              { "color": "#EF4444", "value": 10000 }
            ]
          },
          "min": 0
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 4,
      "title": "Records Out Per Statement",
      "description": "Cumulative records produced by each Flink SQL statement. CC Metrics API metric: io.confluent.flink/num_records_out.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "io_confluent_flink_num_records_out{resource_type=\"flink_statement\"}",
          "legendFormat": "{{statement_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "id": 5,
      "title": "CFU Utilization (%)",
      "description": "Flink Compute Unit (CFU) utilization as a percentage of max_cfu. CC Metrics API metrics: io.confluent.flink/current_cfu and io.confluent.flink/max_cfu.",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 16 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "io_confluent_flink_current_cfu{resource_type=\"flink_compute_pool\"} / io_confluent_flink_max_cfu{resource_type=\"flink_compute_pool\"} * 100",
          "legendFormat": "{{compute_pool_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#22C55E", "value": null },
              { "color": "#22C55E", "value": 0 },
              { "color": "#EAB308", "value": 70 },
              { "color": "#EF4444", "value": 90 }
            ]
          },
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["fsi-kafka", "flink-jobs", "observability"],
  "templating": {
    "list": [
      {
        "name": "CLUSTER_ID",
        "label": "Cluster ID",
        "type": "textbox",
        "current": { "value": "" },
        "options": [],
        "description": "Target Kafka cluster ID"
      },
      {
        "name": "DOMAIN_PREFIX",
        "label": "Domain",
        "type": "textbox",
        "current": { "value": "*" },
        "options": [],
        "description": "Topic domain filter pattern"
      },
      {
        "name": "ENVIRONMENT",
        "label": "Environment",
        "type": "textbox",
        "current": { "value": "prod" },
        "options": [],
        "description": "Environment label"
      },
      {
        "name": "SLA_TIER",
        "label": "SLA Tier",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "current": { "value": ["critical", "standard", "best-effort", "compliance"] },
        "options": [
          { "text": "critical", "value": "critical", "selected": true },
          { "text": "standard", "value": "standard", "selected": true },
          { "text": "best-effort", "value": "best-effort", "selected": true },
          { "text": "compliance", "value": "compliance", "selected": true }
        ],
        "description": "Filter by SLA tier"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "FSI Kafka - Flink Jobs",
  "uid": "fsi-kafka-flink-jobs",
  "version": 2
}
