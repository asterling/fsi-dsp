{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource for Confluent Cloud metrics or JMX exporter metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "FSI Kafka Platform",
        "type": "dashboard"
      }
    ]
  },
  "description": "FSI Kafka Platform - Consumer Lag monitoring. Per-consumer-group lag with SLA-tier threshold lines and domain prefix auto-discovery.",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Consumer Lag: Records Behind by Consumer Group",
      "description": "Consumer lag (records) grouped by consumer group. Topics filtered by domain prefix. Threshold lines show SLA-tier warn/alert levels.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by (consumer_group_id) (confluent_kafka_server_consumer_lag_offsets{kafka_id=\"$CLUSTER_ID\", topic=~\"$DOMAIN_PREFIX.*\", consumer_group_id=~\"$CONSUMER_GROUP\"})",
          "legendFormat": "{{consumer_group_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#22C55E", "value": null },
              { "color": "#EAB308", "value": 1000 },
              { "color": "#EF4444", "value": 5000 }
            ]
          },
          "noValue": "No data available. Verify metrics export is configured and the target cluster is reachable."
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }
      }
    },
    {
      "id": 2,
      "title": "Consumer Lag: Per-Partition Breakdown",
      "description": "Per-partition lag breakdown grouped by consumer group. Identifies hot partitions and uneven consumption.",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "confluent_kafka_server_consumer_lag_offsets{kafka_id=\"$CLUSTER_ID\", topic=~\"$DOMAIN_PREFIX.*\", consumer_group_id=~\"$CONSUMER_GROUP\"}",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#22C55E", "value": null },
              { "color": "#EAB308", "value": 1000 },
              { "color": "#EF4444", "value": 5000 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "displayName", "value": "Lag (records)" },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Lag (records)", "desc": true }]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "kafka_id": true },
            "renameByName": {
              "consumer_group_id": "Consumer Group",
              "topic": "Topic",
              "partition": "Partition",
              "Value": "Lag (records)"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Max Consumer Lag Across All Groups",
      "description": "Maximum consumer lag across all consumer groups matching the domain prefix filter.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 20 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "max(confluent_kafka_server_consumer_lag_offsets{kafka_id=\"$CLUSTER_ID\", topic=~\"$DOMAIN_PREFIX.*\"})",
          "legendFormat": "Max Lag",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#22C55E", "value": null },
              { "color": "#EAB308", "value": 1000 },
              { "color": "#EF4444", "value": 5000 }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto",
        "colorMode": "background"
      }
    },
    {
      "id": 4,
      "title": "SLA Tier Threshold Reference",
      "description": "Consumer lag threshold values per SLA tier for reference.",
      "type": "text",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 20 },
      "options": {
        "mode": "markdown",
        "content": "### Consumer Lag Thresholds by SLA Tier\n\n| SLA Tier | Warn (records) | Alert (records) |\n|----------|---------------|----------------|\n| **critical** | 1,000 | 5,000 |\n| **standard** | 10,000 | 50,000 |\n| **best-effort** | 100,000 | 500,000 |\n| **compliance** | 500 | 2,000 |\n\nThreshold lines on the time series chart above use **critical** tier values by default. Adjust per your SLA tier."
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["fsi-kafka", "consumer-lag", "observability"],
  "templating": {
    "list": [
      {
        "name": "CLUSTER_ID",
        "label": "Cluster ID",
        "type": "textbox",
        "current": { "value": "" },
        "options": [],
        "description": "Target Kafka cluster ID (e.g., lkc-xxxxx)"
      },
      {
        "name": "DOMAIN_PREFIX",
        "label": "Domain",
        "type": "textbox",
        "current": { "value": "*" },
        "options": [],
        "description": "Topic domain filter pattern (e.g., corebanking, fraud, or * for all). Auto-discovery uses wildcard: topic=~'DOMAIN_PREFIX.*'"
      },
      {
        "name": "CONSUMER_GROUP",
        "label": "Consumer Group",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(confluent_kafka_server_consumer_lag_offsets{kafka_id=\"$CLUSTER_ID\"}, consumer_group_id)",
        "current": { "value": "$__all" },
        "description": "Filter by consumer group (auto-populated from metrics)"
      },
      {
        "name": "ENVIRONMENT",
        "label": "Environment",
        "type": "textbox",
        "current": { "value": "prod" },
        "options": [],
        "description": "Environment label (prod, staging, dev)"
      },
      {
        "name": "SLA_TIER",
        "label": "SLA Tier",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "current": { "value": ["critical", "standard", "best-effort", "compliance"] },
        "options": [
          { "text": "critical", "value": "critical", "selected": true },
          { "text": "standard", "value": "standard", "selected": true },
          { "text": "best-effort", "value": "best-effort", "selected": true },
          { "text": "compliance", "value": "compliance", "selected": true }
        ],
        "description": "Filter by SLA tier"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "FSI Kafka - Consumer Lag",
  "uid": "fsi-kafka-consumer-lag",
  "version": 1
}
