{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource for Confluent Cloud metrics or JMX exporter metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_JSON",
      "label": "JSON API",
      "description": "JSON API datasource for Connect REST API polling.",
      "type": "datasource",
      "pluginId": "marcusolsson-json-datasource",
      "pluginName": "JSON API"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "FSI Kafka Platform",
        "type": "dashboard"
      }
    ]
  },
  "description": "FSI Kafka Platform - Snowflake Snowpipe Streaming Sink observability. Tracks the SF-A path from ADR-011: connector state, streaming channel offset lag, DLQ rate, Snowpipe Streaming insert errors.",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "ADR-011 Lakehouse Integration Patterns",
      "url": "/docs/adr/011-lakehouse-integration-patterns.md"
    },
    {
      "title": "Snowflake Integration Guide",
      "url": "/docs/snowflake-integration-guide.md"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Active Snowflake Sinks",
      "description": "Number of lakehouse-snowflake-* connectors currently registered.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": "${DS_JSON}",
      "targets": [
        {
          "method": "GET",
          "urlPath": "/connectors?expand=info",
          "fields": [
            { "jsonPath": "$..[?(@.info.config['connector.class']=='com.snowflake.kafka.connector.SnowflakeSinkConnector')]", "type": "number", "name": "count" }
          ],
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#6B7280", "value": null },
              { "color": "#22C55E", "value": 1 }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "FAILED Tasks",
      "description": "Snowflake sink tasks in FAILED state.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(kafka_connect_connector_task_status{connector=~\"lakehouse-snowflake-.*\", state=\"failed\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#22C55E", "value": null },
              { "color": "#EF4444", "value": 1 }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "title": "DLQ Rate (records/sec)",
      "description": "Records routed to lakehouse.dlq.snowflake-*. Frequent culprits: schematization disagreement, missing role grants, expired key-pair credentials.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(confluent_kafka_server_received_records{topic=~\"lakehouse\\\\.dlq\\\\.snowflake-.*\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#22C55E", "value": null },
              { "color": "#EAB308", "value": 1 },
              { "color": "#EF4444", "value": 10 }
            ]
          },
          "unit": "rps"
        }
      }
    },
    {
      "id": 4,
      "title": "Throughput (records/sec)",
      "description": "Records successfully streamed into Snowflake tables.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(kafka_connect_sink_record_send_total{connector=~\"lakehouse-snowflake-.*\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "rps" }
      }
    },
    {
      "id": 5,
      "title": "Connector + Task State",
      "description": "Per-connector state with task-level breakdown.",
      "type": "table",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 6 },
      "datasource": "${DS_JSON}",
      "targets": [
        {
          "method": "GET",
          "urlPath": "/connectors?expand=status&forConnector=lakehouse-snowflake-",
          "fields": [
            { "jsonPath": "$.*", "type": "string" }
          ],
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Streaming channel offset lag",
      "description": "Per-channel offset gap between Snowflake's last-committed offset and the consumer position. Snowpipe Streaming offers exactly-once via these channel offsets.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "snowflake_streaming_channel_offset_lag{connector=~\"lakehouse-snowflake-.*\"}",
          "legendFormat": "{{connector}} {{channel}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "noValue": "Snowflake connector JMX metrics not yet scraped — verify jmx-exporter-config.yaml is updated." }
      }
    },
    {
      "id": 7,
      "title": "Snowpipe Streaming insert errors by error code",
      "description": "Insert errors broken down by Snowflake error code. Code 0x190E = row size limit; 0x190F = schema mismatch.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "rate(snowflake_streaming_insert_errors_total{connector=~\"lakehouse-snowflake-.*\"}[5m])",
          "legendFormat": "{{connector}} code={{error_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "rps" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["fsi-kafka", "lakehouse", "snowflake", "observability"],
  "templating": {
    "list": [
      {
        "name": "CONNECT_REST_URL",
        "label": "Connect REST URL",
        "type": "textbox",
        "current": { "value": "https://connect-lakehouse.confluent.svc.cluster.local:8083" },
        "options": []
      },
      {
        "name": "ENVIRONMENT",
        "label": "Environment",
        "type": "textbox",
        "current": { "value": "prod" },
        "options": []
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "FSI Kafka - Lakehouse Sink - Snowflake (SF-A)",
  "uid": "fsi-kafka-lakehouse-snowflake",
  "version": 1,
  "weekStart": ""
}
